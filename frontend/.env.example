# Publieke configuratie van de frontend (NIET geheim; wordt in de build opgenomen).
# Kopieer naar .env.local voor lokaal ontwikkelen.

# Adres van de PocketBase-backend
VITE_API_URL=http://127.0.0.1:8090

# Pad waaronder de app draait. GitHub Pages: /facturatie_administratie_ducdalf/
# Geserveerd door PocketBase (pb_public): /
VITE_BASE=/

# Google OAuth Client ID (voor de Gmail-koppeling, fase 3)
VITE_GOOGLE_CLIENT_ID=

# Alleen lokaal: toon een e-mail/wachtwoord-login voor de testgebruiker uit de seed.
VITE_DEV_LOGIN=true
