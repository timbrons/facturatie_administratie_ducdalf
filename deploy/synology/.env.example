# Kopieer naar ".env" in dezelfde map op de NAS en vul in.
# Dit bestand met echte waarden komt NOOIT in de repository.

# Token van de Cloudflare Tunnel (Zero Trust → Networks → Tunnels → je tunnel → Docker)
TUNNEL_TOKEN=

# Google-accounts die mogen inloggen (komma-gescheiden)
DUCDALF_ALLOWED_EMAILS=ducdalf.languedoc@gmail.com

# Websites die de API mogen aanroepen (CORS)
PB_ORIGINS=https://timbrons.github.io,https://verhuur.vakantiehuis-ducdalf.nl
